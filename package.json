{
  "name": "codeglass",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bugdeployer/codeglass.git"
  },
  "description": "See through your codebase: a live map of capabilities, flows and database for Claude Code and Codex.",
  "keywords": [
    "codeglass",
    "claude-code",
    "codex",
    "architecture",
    "codebase-map",
    "visualization",
    "developer-tools",
    "cli"
  ],
  "homepage": "https://github.com/bugdeployer/codeglass",
  "type": "module",
  "bin": {
    "codeglass": "bin/codeglass.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"tsx server/index.ts --no-open\" \"vite\"",
    "server": "tsx server/index.ts --no-open",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server/index.js --log-level=warning",
    "start": "node bin/codeglass.js",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "oxlint",
    "test": "tsx tests/run.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@babel/parser": "^8.1.0",
    "@hono/node-server": "^2.1.6",
    "chokidar": "^6.0.0",
    "hono": "^4.13.17",
    "ignore": "^7.0.14"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.1",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "concurrently": "^10.0.7",
    "d3-hierarchy": "^3.1.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.71.0",
    "motion": "^14.11.1",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
